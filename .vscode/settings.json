{
  "files.eol": "\n",
  "editor.formatOnSave": true,
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx",
    "editor.wordWrap": "on"
  },
  "mdx.server.enable": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "search.exclude": {
    "**/node_modules": true,
    "**/out": true,
    "**/.next": true
  }
}
